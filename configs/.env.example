# Copy this file to .env before running docker compose up.
# Generate secrets with: openssl rand -base64 32

# Model served by vLLM (must fit your VRAM; see configs/README.md sizing notes)
MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# Hugging Face token (only needed for gated models)
HF_TOKEN=

# Maximum context length in tokens (lower this if you hit OOM)
MAX_MODEL_LEN=8192
